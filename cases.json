{
  "schema_version": 1,
  "seed": 20261117,
  "clock": {"type": "fake", "start": 1700000000},
  "audience": "local-linking-service",
  "login_freshness_seconds": 300,
  "session_ttl_seconds": 3600,
  "challenge_ttl_seconds": 300,
  "issuers": [
    {"issuer": "https://idp-alpha.example/", "key_file": "samples/issuer_keys.json"},
    {"issuer": "https://idp-bravo.example/", "key_file": "samples/issuer_keys.json"}
  ],
  "cases": [
    {
      "id": "case01_same_email_distinct_subjects",
      "title": "同邮箱不同主体：邮箱只作展示，两个外部身份各自独立绑定，绝不自动合并",
      "steps": [
        {"op": "create_account", "request_id": "req-c1-acct", "account_id": "acct_c1",
         "display_name": "Carol", "password": "pw-carol",
         "expect": {"status": "ok", "fields": {"account_id": "acct_c1"}}},
        {"op": "login", "request_id": "req-c1-login", "account_id": "acct_c1", "password": "pw-carol",
         "capture": {"sess": "data.session_token"},
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_c1"}}},

        {"op": "start_challenge", "request_id": "req-c1-ch-a", "account_id": "acct_c1",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch_a": "data.challenge_id", "nonce_a": "data.nonce"},
         "expect": {"status": "ok", "fields": {"data.status": "pending"}}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-user-77", "email": "shared@example.com", "nonce": "$nonce_a",
         "capture": {"assert_a": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c1-link-a",
         "challenge_id": "$ch_a", "session_token": "$sess", "assertion_token": "$assert_a",
         "capture": {"link_a": "data.link_id"},
         "expect": {"status": "ok", "fields": {"data.status": "linked",
                                              "data.issuer": "https://idp-alpha.example/",
                                              "data.subject": "alpha-user-77",
                                              "data.email": "shared@example.com"}}},

        {"op": "start_challenge", "request_id": "req-c1-ch-b", "account_id": "acct_c1",
         "session_token": "$sess", "issuer": "https://idp-bravo.example/",
         "capture": {"ch_b": "data.challenge_id", "nonce_b": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-bravo.example/",
         "subject": "bravo-user-99", "email": "shared@example.com", "nonce": "$nonce_b",
         "capture": {"assert_b": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c1-link-b",
         "challenge_id": "$ch_b", "session_token": "$sess", "assertion_token": "$assert_b",
         "expect": {"status": "ok", "fields": {"data.subject": "bravo-user-99",
                                              "data.email": "shared@example.com"}}},
        {"op": "list_identities", "account_id": "acct_c1",
         "expect": {"status": "ok", "fields": {"data.identities": {"size": 2}}}},
        {"op": "find_identity", "issuer": "https://idp-alpha.example/", "subject": "alpha-user-77",
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_c1"}}},
        {"op": "find_identity", "issuer": "https://idp-bravo.example/", "subject": "bravo-user-99",
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_c1"}}},
        {"op": "list_audit", "account_id": "acct_c1", "event_type": "identity_linked",
         "expect": {"status": "ok", "fields": {"data.events": {"size": 2}}}}
      ]
    },
    {
      "id": "case02_browser_session_swap",
      "title": "交换浏览器会话：挑战与单一浏览器会话绑定，换会话完成必须被拒，原会话可正常完成",
      "steps": [
        {"op": "create_account", "request_id": "req-c2-acct", "account_id": "acct_c2",
         "display_name": "Dave", "password": "pw-dave", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c2-login1", "account_id": "acct_c2", "password": "pw-dave",
         "capture": {"sess1": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c2-login2", "account_id": "acct_c2", "password": "pw-dave",
         "capture": {"sess2": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c2-ch", "account_id": "acct_c2",
         "session_token": "$sess1", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-swap-1", "email": "dave@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c2-complete-wrong-session",
         "challenge_id": "$ch", "session_token": "$sess2", "assertion_token": "$assertion",
         "expect": {"status": "error", "error": "challenge_session_mismatch"}},
        {"op": "complete_challenge", "request_id": "req-c2-complete-right-session",
         "challenge_id": "$ch", "session_token": "$sess1", "assertion_token": "$assertion",
         "expect": {"status": "ok", "fields": {"data.status": "linked"}}},
        {"op": "complete_challenge", "request_id": "req-c2-replay",
         "challenge_id": "$ch", "session_token": "$sess1", "assertion_token": "$assertion",
         "expect": {"status": "error", "error": "challenge_consumed"}},
        {"op": "list_challenges", "account_id": "acct_c2",
         "expect": {"status": "ok",
                    "fields": {"data.challenges.0.status": "consumed"}}}
      ]
    },
    {
      "id": "case03_concurrent_race_binding",
      "title": "并发抢绑：两个真实进程同时把同一外部身份绑到不同内部账号，数据库保证唯一胜者",
      "steps": [
        {"op": "create_account", "request_id": "req-c3-acct-a", "account_id": "acct_a",
         "display_name": "Alice", "password": "pw-alice", "expect": {"status": "ok"}},
        {"op": "create_account", "request_id": "req-c3-acct-b", "account_id": "acct_b",
         "display_name": "Bob", "password": "pw-bob", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c3-login-a", "account_id": "acct_a", "password": "pw-alice",
         "capture": {"sess_a": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c3-login-b", "account_id": "acct_b", "password": "pw-bob",
         "capture": {"sess_b": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c3-ch-a", "account_id": "acct_a",
         "session_token": "$sess_a", "issuer": "https://idp-alpha.example/",
         "capture": {"ch_a": "data.challenge_id", "nonce_a": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c3-ch-b", "account_id": "acct_b",
         "session_token": "$sess_b", "issuer": "https://idp-alpha.example/",
         "capture": {"ch_b": "data.challenge_id", "nonce_b": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-contended-1", "email": "race@example.com", "nonce": "$nonce_a",
         "capture": {"assert_a": "data.token"}, "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-contended-1", "email": "race@example.com", "nonce": "$nonce_b",
         "capture": {"assert_b": "data.token"}, "expect": {"status": "ok"}},
        {
          "op": "parallel",
          "id": "race",
          "workers": [
            {"steps": [
              {"op": "complete_challenge", "request_id": "req-c3-race-a",
               "challenge_id": "$ch_a", "session_token": "$sess_a", "assertion_token": "$assert_a",
               "expect": {"status": "ok", "fields": {"data.status": "linked"}}}
            ]},
            {"steps": [
              {"op": "complete_challenge", "request_id": "req-c3-race-b",
               "challenge_id": "$ch_b", "session_token": "$sess_b", "assertion_token": "$assert_b",
               "expect": {"error": "identity_already_bound"}}
            ]}
          ],
          "expect": {
            "workers_ok": 2,
            "aggregate": [
              {"path": "count_where:outcome.status==ok", "op": "eq", "value": 1},
              {"path": "count_where:outcome.error==identity_already_bound", "op": "eq", "value": 1}
            ]
          }
        },
        {"op": "find_identity", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-contended-1",
         "expect": {"status": "ok",
                    "fields": {"data": {"exists": true},
                               "data.account_id": {"contains": "acct"}}}},
        {"op": "list_audit", "event_type": "identity_linked",
         "expect": {"status": "ok", "fields": {"data.events": {"size": 1}}}}
      ]
    },
    {
      "id": "case04_double_unlink_last_two_methods",
      "title": "无口令前提防护：纯联邦账号没有本地口令，口令登录必败，也无法凭无效会话发起挑战",
      "steps": [
        {"op": "create_account", "request_id": "req-c4-acct", "account_id": "acct_c4",
         "display_name": "Erin", "password": null, "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c4-login1", "account_id": "acct_c4",
         "password": "unused",
         "expect": {"status": "error", "error": "password_mismatch"}},

        {"op": "start_challenge", "request_id": "req-c4-ch1", "account_id": "acct_c4",
         "session_token": "bootstrap-session-placeholder",
         "issuer": "https://idp-alpha.example/",
         "expect": {"status": "error", "error": "session_not_found"},
         "note": "无口令账号无法通过口令登录；其两个外部身份由下面的管理引导步骤建立"}
      ]
    },
    {
      "id": "case04b_concurrent_double_unlink",
      "title": "并发双重解绑：两个外部身份是仅有的登录方式，双进程同时解绑，数据库提交顺序决定唯一胜者，败者拿 last_login_method",
      "steps": [
        {"op": "create_account", "request_id": "req-c4b-acct", "account_id": "acct_c4b",
         "display_name": "Erin2", "password": "pw-erin-bootstrap", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c4b-login1", "account_id": "acct_c4b",
         "password": "pw-erin-bootstrap",
         "capture": {"sess1": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c4b-login2", "account_id": "acct_c4b",
         "password": "pw-erin-bootstrap",
         "capture": {"sess2": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c4b-ch1", "account_id": "acct_c4b",
         "session_token": "$sess1", "issuer": "https://idp-alpha.example/",
         "capture": {"ch1": "data.challenge_id", "nonce1": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-erin-1", "email": "erin@example.com", "nonce": "$nonce1",
         "capture": {"a1": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c4b-link1",
         "challenge_id": "$ch1", "session_token": "$sess1", "assertion_token": "$a1",
         "capture": {"link1": "data.link_id"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c4b-ch2", "account_id": "acct_c4b",
         "session_token": "$sess2", "issuer": "https://idp-bravo.example/",
         "capture": {"ch2": "data.challenge_id", "nonce2": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-bravo.example/",
         "subject": "bravo-erin-1", "email": "erin@example.com", "nonce": "$nonce2",
         "capture": {"a2": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c4b-link2",
         "challenge_id": "$ch2", "session_token": "$sess2", "assertion_token": "$a2",
         "capture": {"link2": "data.link_id"}, "expect": {"status": "ok"}},
        {"op": "remove_local_password", "account_id": "acct_c4b",
         "expect": {"status": "ok", "fields": {"data.external_identities": 2}},
         "note": "转为纯联邦账号：仅剩两个外部身份作为登录方式"},
        {
          "op": "parallel",
          "id": "double_unlink_race",
          "workers": [
            {"steps": [
              {"op": "unlink", "request_id": "req-c4b-unlink1",
               "link_id": "$link1", "session_token": "$sess1",
               "expect": {}}
            ]},
            {"steps": [
              {"op": "unlink", "request_id": "req-c4b-unlink2",
               "link_id": "$link2", "session_token": "$sess2",
               "expect": {}}
            ]}
          ],
          "expect": {
            "workers_ok": 2,
            "aggregate": [
              {"path": "count_where:outcome.status==ok", "op": "eq", "value": 1},
              {"path": "count_where:outcome.error==last_login_method", "op": "eq", "value": 1}
            ]
          }
        },
        {"op": "list_identities", "account_id": "acct_c4b",
         "expect": {"status": "ok", "fields": {"data.identities": {"size": 1}}}}
      ]
    },
    {
      "id": "case05_unlink_keeps_last_method",
      "title": "解绑保护：有本地口令时允许解绑外部身份；无口令且仅剩一个外部身份时拒绝解绑",
      "steps": [
        {"op": "create_account", "request_id": "req-c5-acct", "account_id": "acct_c5",
         "display_name": "Frank", "password": "pw-frank", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c5-login", "account_id": "acct_c5", "password": "pw-frank",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c5-ch", "account_id": "acct_c5",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-frank-1", "email": "frank@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c5-link",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$assertion",
         "capture": {"link": "data.link_id"},
         "expect": {"status": "ok"}},
        {"op": "unlink", "request_id": "req-c5-unlink-ok", "link_id": "$link",
         "session_token": "$sess",
         "expect": {"status": "ok", "fields": {"data.status": "unlinked"}}},
        {"op": "unlink", "request_id": "req-c5-unlink-again", "link_id": "$link",
         "session_token": "$sess",
         "expect": {"status": "error", "error": "identity_not_linked"}},
        {"op": "list_identities", "account_id": "acct_c5",
         "expect": {"status": "ok", "fields": {"data.identities": {"size": 0}}}}
      ]
    },
    {
      "id": "case06_idempotency_replay_and_conflict",
      "title": "幂等：丢响应后同 request_id 重放返回既有结果；换参数复用 request_id 必须拒绝",
      "steps": [
        {"op": "create_account", "request_id": "req-c6-acct", "account_id": "acct_c6",
         "display_name": "Grace", "password": "pw-grace", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c6-login", "account_id": "acct_c6", "password": "pw-grace",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c6-ch", "account_id": "acct_c6",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-grace-1", "email": "grace@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c6-link",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$assertion",
         "capture": {"first_link": "data.link_id"},
         "expect": {"status": "ok", "fields": {"data.replayed": false}}},
        {"op": "complete_challenge", "request_id": "req-c6-link",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$assertion",
         "expect": {"status": "ok",
                    "fields": {"data.replayed": true,
                               "data.idempotent_status": "completed",
                               "data.link_id": "$first_link"},
                    "note": "丢响应重放：返回首次存储的同一 link_id，标记 replayed"}},
        {"op": "list_audit", "request_id": "req-c6-link",
         "expect": {"status": "ok", "fields": {"data.events": {"size": 1}},
                    "note": "重放不产生第二条审计"}},
        {"op": "complete_challenge", "request_id": "req-c6-link",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "tampered-payload",
         "expect": {"status": "error", "error": "idempotency_conflict",
                    "note": "换参数复用同一 request_id 必须拒绝"}}
      ]
    },
    {
      "id": "case07_crash_before_commit_then_retry",
      "title": "提交前崩溃：事务未持久化，重启后同 request_id 重试应成功且无重复数据",
      "steps": [
        {"op": "create_account", "request_id": "req-c7-acct", "account_id": "acct_c7",
         "display_name": "Heidi", "password": "pw-heidi", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c7-login", "account_id": "acct_c7", "password": "pw-heidi",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c7-ch", "account_id": "acct_c7",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-heidi-1", "email": "heidi@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {
          "op": "crash_and_retry",
          "id": "crash_before",
          "crash_point": "complete_challenge.before_commit",
          "crash_mode": "exit_before_commit",
          "crash_step": {"op": "complete_challenge", "request_id": "req-c7-link",
                         "challenge_id": "$ch", "session_token": "$sess",
                         "assertion_token": "$assertion"},
          "retry_step": {"op": "complete_challenge", "request_id": "req-c7-link",
                         "challenge_id": "$ch", "session_token": "$sess",
                         "assertion_token": "$assertion"},
          "expect": {"status": "ok", "fields": {"data.status": "linked",
                                               "data.replayed": false}}
        },
        {"op": "find_identity", "issuer": "https://idp-alpha.example/", "subject": "alpha-heidi-1",
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_c7"}}},
        {"op": "list_audit", "request_id": "req-c7-link",
         "expect": {"status": "ok", "fields": {"data.events": {"size": 1}}}}
      ]
    },
    {
      "id": "case08_crash_after_commit_then_retry",
      "title": "提交后崩溃（响应丢失）：重启后同 request_id 重放返回首次结果，不重复绑定",
      "steps": [
        {"op": "create_account", "request_id": "req-c8-acct", "account_id": "acct_c8",
         "display_name": "Ivan", "password": "pw-ivan", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c8-login", "account_id": "acct_c8", "password": "pw-ivan",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c8-ch", "account_id": "acct_c8",
         "session_token": "$sess", "issuer": "https://idp-bravo.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-bravo.example/",
         "subject": "bravo-ivan-1", "email": "ivan@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {
          "op": "crash_and_retry",
          "id": "crash_after",
          "crash_point": "complete_challenge.after_commit",
          "crash_mode": "exit_after_commit",
          "crash_step": {"op": "complete_challenge", "request_id": "req-c8-link",
                         "challenge_id": "$ch", "session_token": "$sess",
                         "assertion_token": "$assertion"},
          "retry_step": {"op": "complete_challenge", "request_id": "req-c8-link",
                         "challenge_id": "$ch", "session_token": "$sess",
                         "assertion_token": "$assertion"},
          "expect": {"status": "ok", "fields": {"data.replayed": true}}
        },
        {"op": "list_identities", "account_id": "acct_c8",
         "expect": {"status": "ok", "fields": {"data.identities": {"size": 1}}}},
        {"op": "list_audit", "request_id": "req-c8-link",
         "expect": {"status": "ok", "fields": {"data.events": {"size": 1}}}}
      ]
    },
    {
      "id": "case09_disable_linearization_and_revocation",
      "title": "禁用线性化：禁用提交后新操作全拒、会话与挑战撤销，重新启用不复活旧挑战",
      "steps": [
        {"op": "create_account", "request_id": "req-c9-acct", "account_id": "acct_c9",
         "display_name": "Judy", "password": "pw-judy", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c9-login", "account_id": "acct_c9", "password": "pw-judy",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c9-ch1", "account_id": "acct_c9",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch1": "data.challenge_id", "nonce1": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "disable_account", "request_id": "req-c9-disable",
         "account_id": "acct_c9", "session_token": "$sess",
         "expect": {"status": "ok", "fields": {"data.enabled": false,
                                              "data.revoked_challenges": 1}}},
        {"op": "start_challenge", "request_id": "req-c9-ch2", "account_id": "acct_c9",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "expect": {"status": "error", "error": "account_disabled"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-judy-1", "email": "judy@example.com", "nonce": "$nonce1",
         "capture": {"assert1": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c9-complete-after-disable",
         "challenge_id": "$ch1", "session_token": "$sess", "assertion_token": "$assert1",
         "expect": {"status": "error", "error": "challenge_revoked"}},
        {"op": "unlink", "request_id": "req-c9-unlink-after-disable",
         "link_id": "link_never_existed", "session_token": "$sess",
         "expect": {"status": "error"}},
        {"op": "enable_account", "request_id": "req-c9-enable", "account_id": "acct_c9",
         "expect": {"status": "ok", "fields": {"data.enabled": true}}},
        {"op": "complete_challenge", "request_id": "req-c9-complete-after-enable",
         "challenge_id": "$ch1", "session_token": "$sess", "assertion_token": "$assert1",
         "expect": {"status": "error", "error": "challenge_revoked",
                    "note": "重新启用后旧挑战仍为 revoked，不复活（优先于会话检查）"}},
        {"op": "login", "request_id": "req-c9-login2", "account_id": "acct_c9", "password": "pw-judy",
         "capture": {"sess2": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c9-complete-old-challenge",
         "challenge_id": "$ch1", "session_token": "$sess2", "assertion_token": "$assert1",
         "expect": {"status": "error", "error": "challenge_revoked"}},
        {"op": "list_challenges", "account_id": "acct_c9",
         "expect": {"status": "ok",
                    "fields": {"data.challenges.0.status": "revoked"}}}
      ]
    },
    {
      "id": "case10_assertion_tampering",
      "title": "断言攻击面：坏签名、错 issuer、错 aud、过期、未来 nbf、nonce 不匹配全部拒绝",
      "steps": [
        {"op": "create_account", "request_id": "req-c10-acct", "account_id": "acct_c10",
         "display_name": "Karl", "password": "pw-karl", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c10-login", "account_id": "acct_c10", "password": "pw-karl",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c10-ch", "account_id": "acct_c10",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "$nonce",
         "corrupt_signature": true, "capture": {"bad_sig": "data.token"},
         "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-bad-sig",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$bad_sig",
         "expect": {"status": "error", "error": "assertion_bad_signature"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "$nonce",
         "sign_with_wrong_key": true, "capture": {"wrong_key": "data.token"},
         "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-wrong-key",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$wrong_key",
         "expect": {"status": "error", "error": "assertion_bad_signature"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "$nonce",
         "audience_override": "https://evil-audience.example/",
         "capture": {"bad_aud": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-bad-aud",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$bad_aud",
         "expect": {"status": "error", "error": "assertion_audience_mismatch",
                    "note": "aud 调包但用正确密钥签名：签名有效，受众检查拒绝"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "$nonce",
         "backdate_expired": true, "capture": {"expired": "data.token"},
         "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-expired",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$expired",
         "expect": {"status": "error", "error": "assertion_expired"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "$nonce",
         "future_nbf": true, "capture": {"future": "data.token"},
         "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-future",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$future",
         "expect": {"status": "error", "error": "assertion_not_yet_valid"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-karl-1", "email": "karl@example.com", "nonce": "stale-nonce",
         "capture": {"bad_nonce": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c10-bad-nonce",
         "challenge_id": "$ch", "session_token": "$sess", "assertion_token": "$bad_nonce",
         "expect": {"status": "error", "error": "assertion_nonce_mismatch"}}
      ]
    },
    {
      "id": "case11_login_freshness_and_challenge_expiry",
      "title": "新鲜度与到期：登录证据过期后拒绝发起/完成；挑战到期后失效且不复活",
      "steps": [
        {"op": "create_account", "request_id": "req-c11-acct", "account_id": "acct_c11",
         "display_name": "Liam", "password": "pw-liam", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c11-login", "account_id": "acct_c11", "password": "pw-liam",
         "capture": {"sess": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "advance_clock", "seconds": 301,
         "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c11-ch-stale", "account_id": "acct_c11",
         "session_token": "$sess", "issuer": "https://idp-alpha.example/",
         "expect": {"status": "error", "error": "login_not_recent"}},
        {"op": "login", "request_id": "req-c11-login2", "account_id": "acct_c11", "password": "pw-liam",
         "capture": {"sess2": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c11-ch", "account_id": "acct_c11",
         "session_token": "$sess2", "issuer": "https://idp-alpha.example/",
         "capture": {"ch": "data.challenge_id", "nonce": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-liam-1", "email": "liam@example.com", "nonce": "$nonce",
         "capture": {"assertion": "data.token"}, "expect": {"status": "ok"}},
        {"op": "advance_clock", "seconds": 301, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c11-complete-expired",
         "challenge_id": "$ch", "session_token": "$sess2", "assertion_token": "$assertion",
         "expect": {"status": "error", "error": "challenge_expired"}}
      ]
    },
    {
      "id": "case12_rebind_after_unlink_and_cross_issuer",
      "title": "解绑后可重新绑定（含被另一账号绑定）；两个身份源同账号并存",
      "steps": [
        {"op": "create_account", "request_id": "req-c12-acct1", "account_id": "acct_m",
         "display_name": "Mia", "password": "pw-mia", "expect": {"status": "ok"}},
        {"op": "create_account", "request_id": "req-c12-acct2", "account_id": "acct_n",
         "display_name": "Nina", "password": "pw-nina", "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c12-login-m", "account_id": "acct_m", "password": "pw-mia",
         "capture": {"sess_m": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "login", "request_id": "req-c12-login-n", "account_id": "acct_n", "password": "pw-nina",
         "capture": {"sess_n": "data.session_token"}, "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c12-ch1", "account_id": "acct_m",
         "session_token": "$sess_m", "issuer": "https://idp-alpha.example/",
         "capture": {"ch1": "data.challenge_id", "nonce1": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-mobile-2", "email": "mia@example.com", "nonce": "$nonce1",
         "capture": {"a1": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c12-link1",
         "challenge_id": "$ch1", "session_token": "$sess_m", "assertion_token": "$a1",
         "capture": {"link1": "data.link_id"}, "expect": {"status": "ok"}},
        {"op": "unlink", "request_id": "req-c12-unlink1", "link_id": "$link1",
         "session_token": "$sess_m", "expect": {"status": "ok"}},
        {"op": "start_challenge", "request_id": "req-c12-ch2", "account_id": "acct_n",
         "session_token": "$sess_n", "issuer": "https://idp-alpha.example/",
         "capture": {"ch2": "data.challenge_id", "nonce2": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-alpha.example/",
         "subject": "alpha-mobile-2", "email": "mia@example.com", "nonce": "$nonce2",
         "capture": {"a2": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c12-link2",
         "challenge_id": "$ch2", "session_token": "$sess_n", "assertion_token": "$a2",
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_n"}}},
        {"op": "find_identity", "issuer": "https://idp-alpha.example/", "subject": "alpha-mobile-2",
         "expect": {"status": "ok", "fields": {"data.account_id": "acct_n"}}},
        {"op": "start_challenge", "request_id": "req-c12-ch3", "account_id": "acct_n",
         "session_token": "$sess_n", "issuer": "https://idp-bravo.example/",
         "capture": {"ch3": "data.challenge_id", "nonce3": "data.nonce"},
         "expect": {"status": "ok"}},
        {"op": "mint_assertion", "issuer": "https://idp-bravo.example/",
         "subject": "bravo-mobile-2", "email": "mia@example.com", "nonce": "$nonce3",
         "capture": {"a3": "data.token"}, "expect": {"status": "ok"}},
        {"op": "complete_challenge", "request_id": "req-c12-link3",
         "challenge_id": "$ch3", "session_token": "$sess_n", "assertion_token": "$a3",
         "expect": {"status": "ok"}},
        {"op": "list_identities", "account_id": "acct_n",
         "expect": {"status": "ok", "fields": {"data.identities": {"size": 2}}}}
      ]
    }
  ]
}
